PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nama_db
BASE_URL=http://localhost:5000
JWT_SECRET=isi_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@pantaujalan.local
ADMIN_PASSWORD=GantiPasswordIni123

# --- Routing (semua opsional, nilai di bawah adalah default-nya) ---
# Server OSRM publik hanya untuk uji coba. Untuk produksi, jalankan OSRM sendiri dengan data OSM.
OSRM_URL=
OSRM_PROFILE=
# Motor: OSRM tidak punya profil motor, default memakai server mobil
# OSRM_MOTOR_URL=
# OSRM_MOTOR_PROFILE=driving
# Pejalan kaki
OSRM_FOOT_URL=
# OSRM_FOOT_PROFILE=driving
OSRM_TIMEOUT_MS=

# Hanya laporan berstatus ini yang dihindari rute dan ditampilkan di /api/routes/hazards
ROUTING_BLOCK_STATUSES=
# Jarak (meter) rute ke laporan agar dianggap "melewati" kerusakan
ROUTING_BUFFER_METERS=
# Jarak (meter) titik belok dari lokasi kerusakan saat memutar
ROUTING_DETOUR_METERS=
ROUTING_MAX_ITER=
ROUTING_PENALTY_SEC=
ROUTING_MAX_DETOUR_FACTOR=

# Tingkat kerusakan yang MASIH BISA dilewati tiap kendaraan (pisahkan dengan koma)
ROUTING_PASSABLE_MOBIL=
ROUTING_PASSABLE_MOTOR=
ROUTING_PASSABLE_JALAN_KAKI=